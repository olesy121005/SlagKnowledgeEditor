<Window x:Class="SlagKnowledgeEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор диаграмм вязкости"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0" Margin="0,0,0,10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ПЕРВАЯ СТРОКА -->
            <StackPanel
        Grid.Row="0"
        Orientation="Horizontal">

                <Button
            x:Name="OpenImageButton"
            Content="Открыть диаграмму"
            Width="160"
            Height="35"
            Margin="0,0,15,5"
            Click="OpenImageButton_Click"/>


                <StackPanel Margin="0,0,15,5">

                    <TextBlock
                Text="Al₂O₃"
                FontWeight="Bold"/>

                    <ComboBox
                x:Name="Al2O3ComboBox"
                Width="100"
                Height="25"
                SelectedIndex="0">

                        <ComboBoxItem Content="5%"/>
                        <ComboBoxItem Content="10%"/>
                        <ComboBoxItem Content="15%"/>

                    </ComboBox>

                </StackPanel>


                <StackPanel Margin="0,0,15,5">

                    <TextBlock
                Text="Температура"
                FontWeight="Bold"/>

                    <ComboBox
                x:Name="TemperatureComboBox"
                Width="100"
                Height="25"
                SelectedIndex="0">

                        <ComboBoxItem Content="1500"/>
                        <ComboBoxItem Content="1450"/>
                        <ComboBoxItem Content="1400"/>

                    </ComboBox>

                </StackPanel>


                <Button
            x:Name="ShowDiagramButton"
            Content="Показать диаграмму"
            Width="170"
            Height="35"
            Margin="0,0,15,5"
            Click="ShowDiagramButton_Click"/>


                <Button
            x:Name="CreateRegionButton"
            Content="Настроить области"
            Width="170"
            Height="35"
            Margin="0,0,15,5"
            Click="CreateRegionButton_Click"/>

            </StackPanel>


            <!-- ВТОРАЯ СТРОКА -->
            <StackPanel
        Grid.Row="1"
        Orientation="Horizontal">

                <Button
            x:Name="SaveRegionButton"
            Content="Сохранить область"
            Width="170"
            Height="35"
            Margin="0,5,15,0"
            Click="SaveRegionButton_Click"/>


                <Button
            x:Name="DetermineCompositionButton"
            Content="Определить состав"
            Width="170"
            Height="35"
            Margin="0,5,15,0"
            Click="DetermineCompositionButton_Click"/>


                <Button
            x:Name="StartCalibrationButton"
            Content="Калибровать диаграмму"
            Width="170"
            Height="35"
            Margin="0,5,15,0"
            Click="StartCalibrationButton_Click"/>


                <Button
            x:Name="ClearCalibrationButton"
            Content="Очистить калибровку"
            Width="170"
            Height="35"
            Margin="0,5,15,0"
            Click="ClearCalibrationButton_Click"/>

                <Button
    Content="Калибровка вязкости"
    Click="StartViscosityCalibrationButton_Click"
    Margin="5"/>

            </StackPanel>

        </Grid>


        <Border
    Grid.Row="1"
    BorderBrush="Gray"
    BorderThickness="1"
    Background="White">

            <Viewbox
        x:Name="DiagramViewbox"
        Stretch="Uniform">

                <Grid
            x:Name="DiagramContainer">

                    <Image
    x:Name="DiagramImage"
    Stretch="None"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Margin="20"
    MouseMove="DiagramImage_MouseMove"
    PreviewMouseLeftButtonDown="DiagramImage_MouseLeftButtonDown"/>

                    <Canvas
                x:Name="DiagramCanvas"
                Background="Transparent"
                IsHitTestVisible="False"/>

                </Grid>

            </Viewbox>

        </Border>

        <Grid Grid.Row="2">

            <TextBlock
        x:Name="StatusText"
        HorizontalAlignment="Left"
        Margin="0,10,0,0"
        FontSize="14"
        Text="Статус: Диаграмма не загружена"/>


            <TextBlock
        x:Name="MousePositionText"
        HorizontalAlignment="Right"
        Margin="0,10,0,0"
        FontSize="14"
        Text="X: 0   Y: 0"/>

        </Grid>

    </Grid>
    
    

</Window>