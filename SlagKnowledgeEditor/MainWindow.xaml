<Window x:Class="SlagKnowledgeEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор диаграмм вязкости"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="0,0,0,10">

            <Button
            x:Name="OpenImageButton"
            Content="Открыть страницу"
            Width="160"
            Height="35"
            Margin="0,0,20,0"
            Click="OpenImageButton_Click"/>


            <StackPanel Margin="0,0,20,0">

                <TextBlock Text="Al₂O₃"
                       FontWeight="Bold"/>

                <ComboBox x:Name="Al2O3ComboBox"
                      Width="100"
                      SelectedIndex="0">

                    <ComboBoxItem Content="5%"/>
                    <ComboBoxItem Content="10%"/>
                    <ComboBoxItem Content="15%"/>

                </ComboBox>

            </StackPanel>


            <StackPanel Margin="0,0,20,0">

                <TextBlock Text="Температура"
                       FontWeight="Bold"/>

                <ComboBox x:Name="TemperatureComboBox"
                      Width="100"
                      SelectedIndex="0">

                    <ComboBoxItem Content="1500"/>
                    <ComboBoxItem Content="1450"/>
                    <ComboBoxItem Content="1400"/>

                </ComboBox>

            </StackPanel>


            <Button
            x:Name="ShowDiagramButton"
            Content="Показать диаграмму"
            Width="170"
            Height="35"
            Margin="0,0,20,0"
            Click="ShowDiagramButton_Click"/>


            <Button
            x:Name="CreateRegionButton"
            Content="Настроить области"
            Width="170"
            Height="35"
            Margin="20,0,0,0"
            Click="CreateRegionButton_Click"/>

            <Button
    x:Name="SaveRegionButton"
    Content="Сохранить область"
    Width="170"
    Height="35"
    Margin="20,0,0,0"
    Click="SaveRegionButton_Click"/>

        </StackPanel>


        <Border
            Grid.Row="1"
            BorderBrush="Gray"
            BorderThickness="1">

            <Canvas
    x:Name="DiagramCanvas"
    Background="White">

                <Image
        x:Name="DiagramImage"
        Stretch="Uniform"
        MouseMove="DiagramImage_MouseMove"
        MouseLeftButtonDown="DiagramImage_MouseLeftButtonDown"/>

            </Canvas>

        </Border>

        <Grid Grid.Row="2">

            <TextBlock
        x:Name="StatusText"
        HorizontalAlignment="Left"
        Margin="0,10,0,0"
        FontSize="14"
        Text="Статус: Диаграмма не загружена"/>


            <TextBlock
        x:Name="MousePositionText"
        HorizontalAlignment="Right"
        Margin="0,10,0,0"
        FontSize="14"
        Text="X: 0   Y: 0"/>

        </Grid>

    </Grid>
    
    

</Window>